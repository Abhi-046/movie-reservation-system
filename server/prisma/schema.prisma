generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String
  role     Role   @default(USER)

  reservations Reservation[]

  createdAt DateTime @default(now())
}

model Movie {
  id String @id @default(uuid())

  title String

  description String

  genre String

  language String

  duration Int

  posterUrl String

  releaseDate DateTime

  rating Float

  showtimes Showtime[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Theatre {
  id      String @id @default(uuid())
  name    String
  city    String
  address String

  screens Screen[]
}

model Screen {
  id String @id @default(uuid())

  name String

  theatreId String

  theatre Theatre @relation(fields: [theatreId], references: [id])

  seats Seat[]

  showtimes Showtime[]
}

enum SeatCategory {
  SILVER
  GOLD
  PLATINUM
}

model Seat {
  id String @id @default(uuid())

  row String

  number Int

  category SeatCategory

  screenId String

  screen Screen @relation(fields: [screenId], references: [id])

  reservationSeats ReservationSeat[]

  reservedSeats ReservedSeat[]

  @@unique([screenId, row, number])
}

model Showtime {
  id String @id @default(uuid())

  movieId String

  screenId String

  startTime DateTime

  endTime DateTime

  price Float

  movie Movie @relation(fields: [movieId], references: [id])

  screen Screen @relation(fields: [screenId], references: [id])

  reservations Reservation[]

  reservedSeats ReservedSeat[]

  createdAt DateTime @default(now())

  @@index([movieId])
  @@index([screenId])
  @@index([startTime])
}

model Reservation {
  id String @id @default(uuid())

  userId String

  showtimeId String

  totalAmount Float

  status ReservationStatus @default(PENDING)

  user User @relation(fields: [userId], references: [id])

  showtime Showtime @relation(fields: [showtimeId], references: [id])

  reservationSeats ReservationSeat[]

  reservedSeats ReservedSeat[]

  payments Payment[]

  createdAt DateTime @default(now())
}

model ReservedSeat {
  id String @id @default(uuid())

  showtimeId String

  seatId String

  reservationId String

  showtime Showtime @relation(fields: [showtimeId], references: [id])

  seat Seat @relation(fields: [seatId], references: [id])

  reservation Reservation @relation(fields: [reservationId], references: [id])

  @@unique([showtimeId, seatId])
}

model ReservationSeat {
  id String @id @default(uuid())

  reservationId String

  seatId String

  reservation Reservation @relation(fields: [reservationId], references: [id])

  seat Seat @relation(fields: [seatId], references: [id])

  @@unique([reservationId, seatId])
}

enum PaymentStatus {
  SUCCESS
  FAILED
  REFUNDED
}

model Payment {
  id String @id @default(uuid())

  paymentReference String @unique

  reservationId String

  amount Float

  status PaymentStatus

  reservation Reservation @relation(fields: [reservationId], references: [id])

  createdAt DateTime @default(now())

  @@index([reservationId])
}
